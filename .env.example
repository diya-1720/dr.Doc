# ==============================================================================
# DR. DOC - ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and provide your actual API keys.
# ==============================================================================

# 1. Google Gemini AI API Key (REQUIRED)
# Obtain key from: https://aistudio.google.com/app/apikey
# In Vercel: Project Settings -> Environment Variables -> GEMINI_API_KEY
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Vite Frontend Gemini API Key (RECOMMENDED for browser fallback)
# In Vercel: Project Settings -> Environment Variables -> VITE_GEMINI_API_KEY
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# 3. Local Backend Port (Default: 5000)
PORT=5000

# 4. Allowed Frontend Origin for CORS (Default: * or your production Vercel domain)
FRONTEND_URL=*

# 5. Maximum upload size per file in bytes (Default: 25 MB = 26214400)
MAX_FILE_SIZE=26214400

# 6. Maximum number of files per batch upload (Limit: 5)
MAX_FILES=5

# 7. Optional Backend API URL
# Leave empty on Vercel for same-origin relative serverless routing (/api/...)
# VITE_API_URL=
