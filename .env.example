# Gemini API Key (Required for AI Forensic Classification, Document OCR & Quality Scoring)
# On Vercel, add this under Project Settings -> Environment Variables -> GEMINI_API_KEY
GEMINI_API_KEY=

# Local Backend Port (Default: 5000)
PORT=5000

# Frontend URL allowed by CORS (Default: http://localhost:5173 in local dev)
FRONTEND_URL=http://localhost:5173

# Max upload size per file, in bytes (default: 25MB)
MAX_FILE_SIZE=26214400

# Max number of files per "multiple images -> PDF" request
MAX_FILES=5

# Optional: Frontend API URL (leave empty in production on Vercel for same-origin serverless routing)
# VITE_API_URL=http://localhost:5000
